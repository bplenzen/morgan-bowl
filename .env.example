# Sleeper Fantasy Football Configuration
# Copy this to .env and fill in your values

# Your Sleeper league ID (find in the Sleeper app URL)
SLEEPER_LEAGUE_ID=your_league_id_here

# Season year (e.g., 2024)
SLEEPER_SEASON=2024

# Path to DuckDB database file (defaults to data/warehouse.duckdb)
DUCKDB_PATH=data/warehouse.duckdb
